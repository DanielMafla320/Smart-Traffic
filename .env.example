# =============================================================================
# SmartTraffic - Variables del docker-compose.yml de la raíz
# -----------------------------------------------------------------------------
# Copiar a .env (que NO se sube a Git) y cambiar las contraseñas:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# Los valores de abajo son SOLO para desarrollo local.
# =============================================================================

# Puerto público de Nginx (único puerto expuesto del sistema).
HTTP_PORT=80

# RabbitMQ
RABBITMQ_USERNAME=smarttraffic
RABBITMQ_PASSWORD=cambiar_rabbitmq_dev

# PostgreSQL: administrador (solo para init.sql y mantenimiento)
POSTGRES_DB=smarttraffic
POSTGRES_ADMIN_USER=smarttraffic_admin
POSTGRES_ADMIN_PASSWORD=cambiar_admin_dev

# PostgreSQL: usuario del traffic-archiver (SELECT + INSERT)
ARCHIVER_DB_USER=archiver_user
ARCHIVER_DB_PASSWORD=cambiar_archiver_dev

# PostgreSQL: usuario del user-dashboard-backend (solo SELECT)
DASHBOARD_DB_USER=dashboard_reader
DASHBOARD_DB_PASSWORD=cambiar_dashboard_dev

# Orígenes permitidos para CORS/WebSocket cuando el frontend se sirve desde
# otro origen. Con Nginx (mismo origen) no hace falta cambiarlo.
DASHBOARD_ALLOWED_ORIGINS=http://localhost
